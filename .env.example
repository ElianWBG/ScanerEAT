# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Base de datos (dejar vacío para usar sqlite local) ---
# En AWS: RDS Postgres
RDS_DB_NAME=
RDS_USERNAME=
RDS_PASSWORD=
RDS_HOSTNAME=
RDS_PORT=5432

# --- AWS (S3 para clips de evidencia, despliegue en EC2) ---
# Credenciales: las lee boto3 por su cadena estándar (estas variables, ~/.aws/credentials
# o el rol IAM de la instancia EC2). Si AWS_STORAGE_BUCKET_NAME queda vacío, el
# microservicio de visión NO graba ni sube clips (el resto funciona igual).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# --- Evidencia (clips por EventoOcupacion) ---
# Prefijo raíz de las keys en el bucket: <prefijo>/<camara_id>/mesa-<id>/<YYYY>/<MM>/<DD>/ocupacion-<inicio>.mp4
EVIDENCIA_PREFIJO_S3=evidencia
# Carpeta local donde se escribe el MP4 mientras dura la ocupación (default: <tmp>/evidencia_clips)
EVIDENCIA_DIR_LOCAL=
# 1 = conservar el MP4 local después de subirlo (o grabar en local aunque no haya bucket S3)
EVIDENCIA_CONSERVAR_LOCAL=0

# --- Microservicio de visión ---
RESTAURANTE_API_URL=http://localhost:8000/api
